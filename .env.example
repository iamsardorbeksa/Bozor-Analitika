# ---------- backend (FastAPI) ----------
# Local default (no setting needed): SQLite file backend/bozor.db
# Production: managed PostgreSQL
DATABASE_URL=postgresql+psycopg://bozor:bozor@localhost:5432/bozor
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=720
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
ENVIRONMENT=development
# Optional. Without it the AI Analyst runs in deterministic, database-driven mode.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Optional, free tier: https://aistudio.google.com/apikey . When set, the AI Analyst and the four agents use
# Gemini first (agents: order parsing + explanation only; every number is computed in code).
GEMINI_API_KEY=
# Optional override, tried before the built-in fallback list
GEMINI_MODEL=
# Optional. Speech-to-text / text-to-speech (uz, ru, en) via voicelab.uz; without it the browser's Web Speech API is used.
VOICELAB_API_KEY=
MAX_UPLOAD_MB=4

# ---------- frontend (Vite) ----------
# Leave empty in development (Vite proxies /api to :8000). In production, the backend URL:
VITE_API_URL=https://your-backend.onrender.com
